#!/usr/bin/env bash
# ==============================================================================
# Tuquet CLI Smart Shim (POSIX Shell: Linux / macOS / WSL)
# Auto-detects native tq or delegates seamlessly to daemon container
# ==============================================================================

if command -v tq >/dev/null 2>&1 && [ "$(command -v tq)" != "$0" ]; then
    # 1. Native tq binary found on host
    exec tq "$@"
else
    # 2. Delegate to Docker container
    if docker ps --filter "name=daemon" --filter "status=running" -q | grep -q .; then
        exec docker exec -i daemon tq "$@"
    else
        echo "Error: tq binary not found on host, and container 'daemon' is not running." >&2
        echo "Hint: Start the core stack first:  docker compose up -d" >&2
        exit 1
    fi
fi
