# ==============================================================================
# TUQUET ECOSYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Quy ước đặt tên: TECHSTACK NAMING SSOT (Không dùng prefix thương hiệu)
# Thứ tự khởi chạy chuẩn (Startup Sequence):
#   1. cloud            -> supabase start (Backend, Database, Auth)
#   2. daemon           -> Loopback Daemon API & Background Worker
#   3. console          -> Web Management Console (depends on Daemon & Supabase)
#   4. docs & bot       -> Optional stacks (Docs portal, Telegram ChatOps)
#
# Cách dùng: Sao chép file này thành .env hoặc .env.local và điền giá trị thực tế.
# KHÔNG COMMIT FILE .env CHỨA SECRETS LÊN GIT!
# ==============================================================================

# ==============================================================================
# [BƯỚC 1] Backend (Supabase Cloud / Self-hosted Database & Auth)
# ==============================================================================
# Local Supabase: http://127.0.0.1:54321
# Cloud Supabase: https://<YOUR_PROJECT_ID>.supabase.co
SUPABASE_URL=https://<YOUR_PROJECT_ID>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here

# Mirror cho Frontend Web Console (Vite build-time injection)
VITE_SUPABASE_URL=https://<YOUR_PROJECT_ID>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here


# ==============================================================================
# [BƯỚC 2] daemon (Core Engine & Loopback Daemon API)
# ==============================================================================
# Host và Port của loopback daemon API
DAEMON_HOST=127.0.0.1
DAEMON_PORT=8765

# Log level của Rust daemon: error, warn, info, debug, trace
RUST_LOG=info

# URL của Workstation Web Console (để CLI tự mở trình duyệt khi login SSO)
CONSOLE_URL=http://localhost:5666

# Cấu hình Gateway SOCKS5 proxy và embedded HTTP forwarder
GATEWAY_SOCKS_PORT=1080
GATEWAY_HTTP_PORT=8118

# Thư mục gốc lưu trữ state, sqlite, encryption keys (để trống sẽ mặc định ~/.tq)
DATA_DIR=

# Sentry / Bugsink DSN gửi crash report lỗi daemon (Tùy chọn)
SENTRY_DSN=https://tuquet@your-bugsink-relay-url/1

# Cấu hình Automation Worker Claim Loop (Pull-based execution)
CLAIM_ENABLED=0
CLAIM_INTERVAL_SECS=10
JOB_LEASE_MINUTES=15


# ==============================================================================
# [BƯỚC 3] console (Unified Web Management Console)
# ==============================================================================
# Port phục vụ Web Console
VITE_PORT=5666

# Port của Daemon API để Console kết nối thăm dò trạng thái (phớp DAEMON_PORT)
VITE_DAEMON_PORT=8765

# Cloudflare Turnstile Bot Detection (Dùng test site key mặc định cho local dev)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Bật hoặc tắt gửi crash report từ browser lên Bugsink
VITE_BUGSINK_ENABLED=false
VITE_BUGSINK_DSN=


# ==============================================================================
# [OPTIONAL] docs (--profile docs: VitePress Technical Documentation Portal)
# ==============================================================================
DOCS_PORT=3333


# ==============================================================================
# [OPTIONAL] bot (--profile ops: Telegram Operations & Notification Bot)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=
ADMIN_USER_IDS=


# ==============================================================================
# [OPTIONAL] bugsink (--profile telemetry: Self-hosted Sentry-compatible Tracker)
# ==============================================================================
BUGSINK_PORT=8000
BUGSINK_SECRET_KEY=<REPLACE_WITH_MINIMUM_50_CHAR_SECRET_KEY>
BUGSINK_ADMIN_CREDENTIALS=admin@tuquet.local:<REPLACE_WITH_SECURE_PASSWORD>
