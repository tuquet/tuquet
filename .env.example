# ==============================================================================
# TUQUET ECOSYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Thứ tự khởi chạy chuẩn (Startup Sequence):
#   1. tuquet/cloud     -> supabase start (Backend, Database, Auth)
#   2. tq-cli-daemon    -> tq daemon (Core Engine, Loopback API)
#   3. tq-workstation   -> Web Console UI (depends on Daemon & Supabase)
#   4. tq-docs & tq-bot -> Optional stacks (Docs portal, Telegram ChatOps)
#
# Cách dùng: Sao chép file này thành .env hoặc .env.local và điền giá trị thực tế.
# KHÔNG COMMIT FILE .env CHỨA SECRETS LÊN GIT!
# ==============================================================================

# ==============================================================================
# [BƯỚC 1] tuquet/cloud (Supabase Backend - Database, Auth & PostgREST)
# ==============================================================================
# Local Supabase: http://127.0.0.1:54321
# Cloud Supabase: https://<YOUR_PROJECT_ID>.supabase.co
TQ_CLOUD_URL=https://<YOUR_PROJECT_ID>.supabase.co
VITE_SUPABASE_URL=https://<YOUR_PROJECT_ID>.supabase.co

# Public Publishable Key (Anon Key) dùng cho client SDK / frontend
TQ_CLOUD_ANON_KEY=sb_publishable_your_anon_key_here
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here


# ==============================================================================
# [BƯỚC 2] tq-cli-daemon (Core Rust Engine & Loopback Daemon)
# ==============================================================================
# Host và Port của loopback daemon API
TQ_HOST=127.0.0.1
TQ_PORT=8765

# Log level của CLI daemon: error, warn, info, debug, trace
TQ_LOG_LEVEL=info

# URL của Workstation Web Console (để CLI tự mở trình duyệt khi login SSO)
TQ_CONSOLE_URL=http://localhost:5666

# Cấu hình Gateway SOCKS5 proxy và embedded HTTP forwarder
TQ_GATEWAY_SOCKS_PORT=1080
TQ_GATEWAY_HTTP_PORT=8118

# Thư mục gốc lưu trữ state, sqlite, encryption keys (để trống sẽ mặc định ~/.tq)
TQ_HOME=

# DSN gửi crash report lỗi daemon (Tùy chọn)
TQ_BUGSINK_DSN=https://tuquet@your-bugsink-relay-url/1


# ==============================================================================
# [BƯỚC 3] tq-workstation (Web Console SPA Frontend)
# ==============================================================================
# Port lắng nghe của Workstation Console
VITE_PORT=5666

# Port của CLI Daemon để Console kết nối thăm dò trạng thái (phải khớp TQ_PORT)
VITE_DAEMON_PORT=8765

# Tiêu đề và namespace của ứng dụng Web
VITE_APP_TITLE=Tuquet Admin
VITE_APP_NAMESPACE=admin
VITE_APP_STORE_SECURE_KEY=admin-secure-key-example

# Router history mode: 'history' hoặc 'hash'
VITE_ROUTER_HISTORY=history

# OAuth callback redirect URL (để trống sẽ tự động nhận diện theo window.location.origin)
VITE_AUTH_CALLBACK_URL=

# Cloudflare Turnstile Captcha Site Key
# Mặc định dùng Test Key của Cloudflare (luôn pass): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Telemetry theo dõi lỗi frontend (Bugsink / Sentry)
VITE_BUGSINK_ENABLED=false
VITE_BUGSINK_DSN=https://tuquet@your-bugsink-relay-url/1


# ==============================================================================
# [OPTIONAL 1] tq-docs (--profile docs: Cổng Tài Liệu Kỹ Thuật)
# ==============================================================================
# Port của Technical Docs Portal (VitePress)
DOCS_PORT=3333


# ==============================================================================
# [OPTIONAL 2] tq-bot (--profile ops: Telegram ChatOps Bot Vận Hành)
# ==============================================================================
# Telegram Bot Token được cấp từ @BotFather
TELEGRAM_BOT_TOKEN=

# Danh sách Chat ID được phép gửi lệnh (ngăn cách bằng dấu phẩy)
ALLOWED_CHAT_IDS=

# Danh sách User ID có quyền Admin cao nhất
ADMIN_USER_IDS=
