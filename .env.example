# ==============================================================================
# TUQUET ECOSYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Thứ tự khởi chạy chuẩn (Startup Sequence):
#   1. tuquet/cloud     -> supabase start (Backend, Database, Auth)
#   2. tq-cli-daemon    -> tq worker start (Core Engine, Loopback API)
#   3. tq-workstation   -> Web Console UI (depends on Daemon & Supabase)
#   4. tq-docs & tq-bot -> Optional stacks (Docs portal, Telegram ChatOps)
#
# Cách dùng: Sao chép file này thành .env hoặc .env.local và điền giá trị thực tế.
# KHÔNG COMMIT FILE .env CHỨA SECRETS LÊN GIT!
# ==============================================================================

# ==============================================================================
# [BƯỚC 1] tuquet/cloud (Supabase Backend - Database, Auth & PostgREST)
# ==============================================================================
# Local Supabase: http://127.0.0.1:54321
# Cloud Supabase: https://<YOUR_PROJECT_ID>.supabase.co
TUQUET_CLOUD_URL=https://<YOUR_PROJECT_ID>.supabase.co
VITE_SUPABASE_URL=https://<YOUR_PROJECT_ID>.supabase.co

# Public Publishable Key (Anon Key) dùng cho client SDK / frontend
TUQUET_CLOUD_ANON_KEY=sb_publishable_your_anon_key_here
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here


# ==============================================================================
# [BƯỚC 2] tq-cli-daemon (Core Rust Engine & Loopback Daemon)
# ==============================================================================
# Host và Port của loopback daemon API
TUQUET_HOST=127.0.0.1
TUQUET_PORT=8765

# Log level của CLI daemon: error, warn, info, debug, trace
TUQUET_LOG_LEVEL=info

# URL của Workstation Web Console (để CLI tự mở trình duyệt khi login SSO)
TUQUET_CONSOLE_URL=http://localhost:5666

# Cấu hình Gateway SOCKS5 proxy và embedded HTTP forwarder
TUQUET_GATEWAY_SOCKS_PORT=1080
TUQUET_GATEWAY_HTTP_PORT=8118

# Thư mục gốc lưu trữ state, sqlite, encryption keys (để trống sẽ mặc định ~/.tuquet hoặc ~/.tq)
TUQUET_HOME=

# DSN gửi crash report lỗi daemon (Tùy chọn)
TUQUET_BUGSINK_DSN=https://tuquet@your-bugsink-relay-url/1


# ==============================================================================
# [BƯỚC 3] tq-workstation (Unified Web Console)
# ==============================================================================
# Port phục vụ Web Console
VITE_PORT=5666

# Port của CLI Daemon để Console kết nối thăm dò trạng thái (phải khớp TUQUET_PORT)
VITE_DAEMON_PORT=8765

# Cloudflare Turnstile Bot Detection (Dùng test site key mặc định cho local dev)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Bật hoặc tắt gửi crash report từ browser lên Bugsink
VITE_BUGSINK_ENABLED=false
VITE_BUGSINK_DSN=


# ==============================================================================
# [OPTIONAL] tq-docs (--profile docs: VitePress Technical Documentation Portal)
# ==============================================================================
DOCS_PORT=3333


# ==============================================================================
# [OPTIONAL] tq-bot (--profile ops: Telegram Operations & Notification Bot)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=
ADMIN_USER_IDS=


# ==============================================================================
# [OPTIONAL] tq-bugsink (--profile telemetry: Self-hosted Sentry-compatible Tracker)
# ==============================================================================
BUGSINK_PORT=8000
BUGSINK_SECRET_KEY=<REPLACE_WITH_MINIMUM_50_CHAR_SECRET_KEY>
BUGSINK_ADMIN_CREDENTIALS=admin@tuquet.local:<REPLACE_WITH_SECURE_PASSWORD>
