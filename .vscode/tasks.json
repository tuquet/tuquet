{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[cli] Fast Dev Install (1.6s)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/cli/scripts/dev-install.ps1",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "[cli] Run Tests & Contract",
      "type": "shell",
      "command": "cargo test --manifest-path ${workspaceFolder}/cli/Cargo.toml",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[cloud] supabase start",
      "type": "shell",
      "command": "supabase start",
      "options": {
        "cwd": "${workspaceFolder}/cloud"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[cloud] supabase stop",
      "type": "shell",
      "command": "supabase stop",
      "options": {
        "cwd": "${workspaceFolder}/cloud"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[cloud] supabase db reset",
      "type": "shell",
      "command": "supabase db reset",
      "options": {
        "cwd": "${workspaceFolder}/cloud"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[admin] pnpm dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/admin"
      },
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[docs] pnpm dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/docs"
      },
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[workspace] git submodule update",
      "type": "shell",
      "command": "git submodule update --init --recursive",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
