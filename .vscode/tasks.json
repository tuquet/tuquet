{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[cli] dev install",
      "detail": "Biên dịch nhanh bản debug và cài đè vào ~/.tq/bin/tq.exe trong ~1.6s. Dùng khi đang code tính năng mới cho CLI để test ngay lệnh `tq`.",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/cli/scripts/dev-install.ps1",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "[cli] test & contract",
      "detail": "Chạy toàn bộ cargo test và schema contract verification cho CLI core.",
      "type": "shell",
      "command": "cargo test --manifest-path ${workspaceFolder}/cli/Cargo.toml",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[cloud] supabase start",
      "detail": "Khởi động local Supabase stack (PostgreSQL, Auth, Storage, Edge Runtime).",
      "type": "shell",
      "command": "supabase start",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/cloud"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[cloud] supabase stop",
      "detail": "Dừng toàn bộ container Supabase local đang chạy.",
      "type": "shell",
      "command": "supabase stop",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/cloud"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[cloud] supabase db reset",
      "detail": "Reset database local và migrate lại toàn bộ schema từ đầu.",
      "type": "shell",
      "command": "supabase db reset",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/cloud"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[console] pnpm dev",
      "detail": "Khởi động Vite dev server cho ứng dụng Tuquet Console / Workstation.",
      "type": "shell",
      "command": "pnpm dev",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/console"
      },
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[docs] pnpm dev",
      "detail": "Khởi động VitePress dev server cho cổng tài liệu docs.tuquet.com.",
      "type": "shell",
      "command": "pnpm dev",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/docs"
      },
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[workspace] git submodule update",
      "detail": "Đồng bộ và khởi tạo đệ quy toàn bộ các git submodule trong workspace.",
      "type": "shell",
      "command": "git submodule update --init --recursive",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}