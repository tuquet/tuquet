{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuquet Workstation",
  "version": "0.1.0",
  "identifier": "com.tuquet.workstation",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5320",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co https://*.tuquet.com http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' asset: https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tuquet"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2QzNBQTVGN0M5NzFENTQKUldSVUhaZDhYNnJEOWx5YmhUalcrREpPWjBhYURnSFYzak5odzljZWlaVFk5TE5NTXpnQmE0OW8K",
      "endpoints": [
        "https://github.com/tuquet/console/releases/latest/download/latest.json"
      ]
    }
  }
}
