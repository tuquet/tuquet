# ==============================================================================
# WORKSTATION WEB CONSOLE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Application Meta
VITE_APP_TITLE=Tuquet Admin
VITE_APP_NAMESPACE=admin
VITE_APP_STORE_SECURE_KEY=admin-secure-key-example

# Router & Server
VITE_PORT=5666
VITE_DAEMON_PORT=8765
VITE_BASE=/
VITE_ROUTER_HISTORY=history
VITE_GLOB_API_URL=/api

# Supabase Cloud Configuration
VITE_SUPABASE_URL=https://<YOUR_PROJECT_ID>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here

# Optional: OAuth Callback Redirect (Defaults dynamically to window.location.origin)
VITE_AUTH_CALLBACK_URL=

# Cloudflare Turnstile Captcha (Cloudflare testing key: 1x00000000000000000000AA)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Bugsink / Sentry Telemetry
VITE_BUGSINK_ENABLED=false
VITE_BUGSINK_DSN=https://tuquet@your-bugsink-relay-url/1
