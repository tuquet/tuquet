{
  "recommendations": [
    // Vue 3 language support
    "Vue.volar",
    // Integrates ESLint into VS Code
    "dbaeumer.vscode-eslint",
    // Integrates oxlint into VS Code
    "oxc.oxc-vscode",
    // Official Stylelint extension for VS Code
    "stylelint.vscode-stylelint",
    // Dotenv file syntax support
    "mikestead.dotenv",
    // YAML language support for ESLint validation of pnpm-workspace.yaml etc.
    "redhat.vscode-yaml",
    // Spell checker for source code
    "streetsidesoftware.code-spell-checker",
    // Official Tailwind CSS VS Code extension
    "bradlc.vscode-tailwindcss",
    // Iconify icons extension
    "antfu.iconify",
    // i18n extension
    "Lokalise.i18n-ally",
    // CSS variables autocomplete
    "vunguyentuan.vscode-css-variables",
    // Display PNPM catalog versions in package.json
    "antfu.pnpm-catalog-lens"
  ],
  "unwantedRecommendations": [
    // Conflicts with Volar
    "octref.vetur"
  ]
}
