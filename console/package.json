{
  "name": "@tuquet/console",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "tuquet",
    "admin",
    "vue3",
    "dashboard",
    "shadcn"
  ],
  "homepage": "https://console.tuquet.com",
  "bugs": "https://github.com/tuquet/console/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuquet/console.git"
  },
  "license": "MIT",
  "author": "tuquet",
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=3072 turbo build --concurrency=1",
    "build:analyze": "turbo build:analyze --concurrency=1",
    "build:admin": "pnpm -F @tuquet/workstation run build",
    "build:workstation": "pnpm -F @tuquet/workstation run build",
    "build:desktop": "pnpm -F @tuquet/workstation run tauri:build",
    "build:desktop:exe": "pnpm -F @tuquet/workstation run tauri:build:exe",
    "build:local": "bash ./scripts/build-local.sh",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:console": "node ./scripts/check-console.mjs",
    "check:cspell": "cspell lint \"**/*.ts\" \"**/README.md\" \".changeset/*.md\" --no-progress",
    "check:dep": "vsh check-dep",
    "check:i18n": "node ./scripts/check-i18n.mjs",
    "check:type": "turbo run typecheck --concurrency=1",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "pnpm -F @tuquet/workstation run dev",
    "dev:admin": "pnpm -F @tuquet/workstation run dev",
    "dev:workstation": "pnpm -F @tuquet/workstation run dev",
    "dev:desktop": "pnpm -F @tuquet/workstation run tauri:dev",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "tauri:build": "pnpm -F @tuquet/workstation run tauri:build",
    "tauri:build:exe": "pnpm -F @tuquet/workstation run tauri:build:exe",
    "tauri:check": "cd apps/workstation/src-tauri && cargo check",
    "tauri:dev": "pnpm -F @tuquet/workstation run tauri:dev",
    "postinstall": "pnpm -r run --if-present stub",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || pnpm exec lefthook install --force || true",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "reinstall": "pnpm run clean -- --del-lock && pnpm install",
    "test:benchmark": "vitest bench --run",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "update:deps": "npx taze -r -w",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
    "catalog": "pnpm dlx codemod pnpm/catalog"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@tsdown/css": "catalog:",
    "@tuquet/commitlint-config": "workspace:*",
    "@tuquet/eslint-config": "workspace:*",
    "@tuquet/oxfmt-config": "workspace:*",
    "@tuquet/oxlint-config": "workspace:*",
    "@tuquet/stylelint-config": "workspace:*",
    "@tuquet/tailwind-config": "workspace:*",
    "@tuquet/tsconfig": "workspace:*",
    "@tuquet/turbo-run": "workspace:*",
    "@tuquet/vite-config": "workspace:*",
    "@tuquet/vsh": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-i18n-extract": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.16.0"
}
