{
  "name": "tuquet-profile",
  "version": "1.0.0",
  "private": true,
  "description": "Toby Nguyen - Professional Engineering Resume and Profile Documentation",
  "scripts": {
    "build:docs": "tuquet-md-pdf --dir . --styles style/pdf-export.css",
    "build:web": "node scripts/inject-web.js",
    "build": "tuquet-md-pdf --dir . --styles style/pdf-export.css && node scripts/inject-web.js",
    "test:seo": "node scripts/test-seo.js",
    "test": "npm run test:seo",
    "check": "npm run build && npm run test"
  },
  "devDependencies": {
    "@tuquet/md-pdf": "file:../tuquet/lib/packages/md-pdf"
  }
}
